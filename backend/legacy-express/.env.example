# NullSec backend — environment (copy to .env)
# NEVER commit the real .env
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://nullsec:nullsec@localhost:5432/nullsec
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=168
AUTH_RATE_LIMIT=5
# Comma-separated allowed frontend origins, e.g. https://neonmc23.github.io
ALLOWED_ORIGINS=
