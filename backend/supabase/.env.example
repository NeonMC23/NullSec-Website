# NullSec — Supabase environment (copy to .env, NEVER commit)
#
# PUBLIC (safe for the frontend / GitHub Pages):
#   SUPABASE_URL         — Supabase project URL, e.g. https://xxxx.supabase.co
#   SUPABASE_ANON_KEY    — the public anon key (frontend)
#
# PRIVATE (server/deploy environment ONLY — never in the frontend):
#   SUPABASE_SERVICE_KEY — service-role key (bypasses RLS); keep secret

NODE_ENV=development

# --- PUBLIC ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# --- PRIVATE (never ship to the frontend) ---
# SUPABASE_SERVICE_KEY=your-service-role-key
